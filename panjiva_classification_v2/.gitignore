# Panjiva Classification v2 - Git Ignore Rules

# Data Files (too large for git)
01_RAW_DATA/
03_DATA/
04_TESTS/*.csv
04_TESTS/**/*.csv

# Logs
05_LOGS/
*.log

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/
*.ipynb

# System Files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary Files
*.tmp
*.temp
*.bak
*.backup

# Keep these folders but ignore contents
03_DATA/**
!03_DATA/.gitkeep
04_TESTS/**
!04_TESTS/.gitkeep
05_LOGS/**
!05_LOGS/.gitkeep

# Keep structure files
!02_SCRIPTS/
!00_REFERENCE/
!06_DOCUMENTATION/

# Archive old versions but don't commit
02_SCRIPTS/_archive/
_archive/
